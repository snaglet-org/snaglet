# Snaglet environment. `pnpm dev` copies this file to .env (ignored by git) on first
# run and fills in CREDENTIAL_ENCRYPTION_KEY. Put per-checkout overrides and
# anything with a password in .env.local, which wins over .env. $VAR references
# are expanded. Defaults and details: docs/dev-environment.md.

# General

NODE_ENV=development
# Launch mode (dev | preview | prod); the pnpm scripts set it, so leave it unset.
# SNAGLET_ENV=
# Snaglet data folder, an absolute path (pnpm dev uses ~/.snaglet-dev).
# SNAGLET_HOME=

# Server

# Server and UI ports; change them only to run a second checkout alongside.
PORT=4001
CLIENT_PORT=3001
API_BASE_URL=http://localhost:$PORT

# Background workers (archive sweeper, embedding worker); false turns them off.
# RUN_BACKGROUND_WORKERS=true
# Conversation summaries (compaction); false turns them off.
# COMPACT_CONVERSATIONS=true
# Opt in to local background compute (local model setup, embeddings).
# SNAGLET_LOCAL_INTELLIGENCE=true
# Rate limit for remote API clients; loopback requests are never limited.
# SNAGLET_API_RATE_LIMIT_PER_SECOND=10
# SNAGLET_API_RATE_LIMIT_BURST=100
# Extra browser origins allowed to call the API (comma-separated).
# SNAGLET_ALLOWED_ORIGINS=
# Extra Host header values the server answers, e.g. a reverse proxy (comma-separated).
# SNAGLET_ALLOWED_HOSTS=

# Database

# By default Snaglet runs its own PostgreSQL cluster under <SNAGLET_HOME>/postgres.
# Database name in the managed cluster (lowercase letters, digits, underscores).
# SNAGLET_DATABASE_NAME=snaglet
# Managed cluster data folder (default <SNAGLET_HOME>/postgres).
# SNAGLET_PG_DATA_DIR=
# PostgreSQL runtime cache (default <SNAGLET_HOME>/cache/postgres-runtime).
# SNAGLET_PG_RUNTIME_DIR=
# Use an existing PostgreSQL database instead of the managed cluster.
# SNAGLET_DATABASE_URL=postgresql://user:password@host/database
# Agent SQL roles when SNAGLET_DATABASE_URL is set (managed mode creates them itself);
# see docs/architecture.md#agent-sql-roles.
# SNAGLET_TABLES_READER_URL=postgresql://snaglet_tables_reader:password@host/database
# SNAGLET_WORKSPACE_READER_URL=postgresql://snaglet_workspace_reader:password@host/database
# SNAGLET_WORKSPACE_WRITER_URL=postgresql://snaglet_workspace_writer:password@host/database

# Credential encryption

# Required: 64 hex characters that encrypt stored API keys. Keep it; credentials
# saved with it cannot be read without it. pnpm dev generates one, or run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Provider credentials (optional)

# In development, non-empty values are saved on startup as "Test credential"
# rows in the encrypted credential store.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CODEX_ACCESS_TOKEN=
# CODEX_REFRESH_TOKEN=
# CODEX_ACCOUNT_ID=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=
# COPILOT_SECRET=
# COPILOT_TOKEN=
# COPILOT_BASE_URL=
# COPILOT_EXPIRES_AT=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=

# Logging

# error | warn | info | debug
LOG_LEVEL=error
# Log model request payloads (debugging only).
# LOG_PROVIDER_PAYLOADS=false
# false keeps logs on the console only (no rotating files in <SNAGLET_HOME>/logs).
# SNAGLET_LOG_FILE=false
