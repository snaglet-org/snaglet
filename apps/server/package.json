{
  "name": "@snaglet/server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "pnpm run gen:tool-registry && tsc && tsc-alias",
    "start": "cross-env NODE_ENV=production node ../../dist/server/apps/server/src/index.js",
    "sync:tool": "tsx src/services/ToolService/scripts/sync-internal-tool.ts",
    "reranker:fetch": "tsx src/scripts/fetch-reranker-model.ts",
    "embedder:fetch": "tsx src/scripts/fetch-embedder-model.ts",
    "voice:fetch": "tsx src/scripts/fetch-voice-models.ts",
    "stt:build": "bash native/apple-stt/build.sh",
    "tts:build": "bash native/apple-tts/build.sh",
    "nlp:build": "bash native/nlp-helper/build.sh",
    "chat:build": "bash native/apple-chat/build.sh",
    "voice:smoke": "tsx src/scripts/voice-smoke.ts",
    "test:e2e": "tsx src/scripts/e2e/run.ts",
    "embedder:verify": "tsx src/scripts/verify-embedder.ts",
    "db:backup:verify": "tsx src/scripts/verify-backup-restore.ts",
    "typecheck": "pnpm run gen:tool-registry && tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:tool": "tsx src/services/ToolService/scripts/typecheck-tool.ts",
    "gen:tool-registry": "tsx src/services/ToolService/scripts/generate-tool-registry.ts",
    "audit:tool-registry": "tsx src/services/ToolService/scripts/audit-tool-registry.ts --strict",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@snaglet/db": "workspace:*",
    "@snaglet/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^3.6.0",
    "chrono-node": "^2.9.1",
    "cors": "^2.8.5",
    "cross-spawn": "7.0.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^173.0.0",
    "playwright-core": "1.58.2",
    "ignore": "7.0.5",
    "js-tiktoken": "^1.0.21",
    "minimatch": "^10.2.5",
    "morgan": "^1.10.1",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.4",
    "sherpa-onnx-node": "1.13.3",
    "unpdf": "^1.6.2",
    "winston": "^3.18.3",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/cross-spawn": "6.0.6",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.3",
    "nodemon": "^3.1.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
