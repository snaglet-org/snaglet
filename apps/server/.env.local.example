# apps/server/.env.local.example: server-only overrides.
# Copy this file to .env.local and fill in your values. The server also loads
# the root .env (found by walking up directories); values here override it for
# the server process. Most config lives in the root .env.


# Server configuration
# .env.local is the per-checkout override location, loaded by the server with
# precedence over the root .env. Dev ports default to 4001 (server) and 3001
# (client / Vite UI) in code (scripts/lib/dev-ports.mjs); pin these ONLY when a
# port is taken, e.g. a second checkout running concurrently. A busy port FAILS
# LOUD (server EADDRINUSE / Vite strictPort) — never an auto-switch. CLIENT_PORT
# is the one Vite port shared by the browser and the Tauri desktop shell.
# PORT=4002
# CLIENT_PORT=3002

# HOST=localhost
# API_BASE_URL is auto-filled to http://localhost:<PORT> in dev — pin it only
# alongside a custom PORT (or in production).
# API_BASE_URL=http://$HOST:$PORT


# Database
# Managed mode is the default. Snaglet provisions a pinned local PostgreSQL runtime
# and stores the cluster in <SNAGLET_HOME>/postgres; no database URL is needed.
# SNAGLET_PG_DATA_DIR=/absolute/path/to/isolated/postgres
# SNAGLET_PG_RUNTIME_DIR=/absolute/path/to/postgres-runtime-cache
#
# SNAGLET_DATABASE_NAME picks the database inside the managed cluster. Defaults to
# `snaglet`; lowercase letters, digits and underscores only.
# SNAGLET_DATABASE_NAME=snaglet
#
# Setting SNAGLET_DATABASE_URL connects to a database somebody else runs, and Snaglet
# never starts or stops that server. Its presence alone selects the override.
# Keep URLs with passwords in this ignored local file.
# SNAGLET_DATABASE_URL=postgresql://snaglet:password@localhost:5432/snaglet_checkout
