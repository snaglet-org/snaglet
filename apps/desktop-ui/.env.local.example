###############################################################
#  apps/desktop-ui/.env.local — Desktop UI (Tauri frontend)   #
###############################################################

# NOTE:
# - Copy this file to .env.local and fill in your values.
# - All client env vars MUST start with VITE_ to be exposed to the browser.
# - dotenv-expand is used, so $VAR references are expanded.


# ╔══════════════════════════════════════════════════════════════╗
# ║ Client (Vite UI) Port                                        ║
# ╚══════════════════════════════════════════════════════════════╝
# The Vite dev-server port — used by BOTH the browser and the Tauri desktop
# shell. Defaults to 3001 in code (scripts/lib/dev-ports.mjs); Vite loads this
# .env.local automatically (precedence over the root .env), and Tauri's devUrl
# is patched to match. Override ONLY for a concurrent second checkout — Vite
# fails loud (strictPort) if the port is taken.
# CLIENT_PORT=3002


# ╔══════════════════════════════════════════════════════════════╗
# ║ API Configuration                                            ║
# ╚══════════════════════════════════════════════════════════════╝
# Not needed in dev: the browser uses the relative `/api`, which the Vite dev
# server proxies to the server. Set this only to point the client at a specific
# non-proxied absolute API origin.
# VITE_API_BASE_URL=${API_BASE_URL}/api


# ╔══════════════════════════════════════════════════════════════╗
# ║ App Configuration                                            ║
# ╚══════════════════════════════════════════════════════════════╝
VITE_NODE_ENV=development
VITE_APP_NAME=Snaglet


###############################################################
# Developer Tooling                                           #
###############################################################
# Opt into code-inspector-plugin JSX instrumentation. Leave off
# during normal development; the inspector can interfere with Vite's
# React transform for module-level JSX.
# CODE_INSPECTOR=true
