{
  "productName": "Snaglet",
  "version": "1.0.0",
  "identifier": "com.snaglet.app",
  "build": {
    "beforeDevCommand": "node scripts/patch-tauri-port.mjs && pnpm -w run dev:desktop-ui",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/stage-sidecar.mjs",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/snaglet-org/snaglet/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NUUxOEU2OENCNTQ1MjMKUldRalJiV001aGhlU0syY0N5UFdkRk5iWk9XKzlzdkdrZWNjZEJldmhFeUxGNEljR0toMWxaL1cK"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/snaglet-node"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "files": {
        "Resources/chime.wav": "../../desktop-ui/public/sounds/reminders/chime.wav",
        "Resources/bell.wav": "../../desktop-ui/public/sounds/reminders/bell.wav",
        "Resources/ping.wav": "../../desktop-ui/public/sounds/reminders/ping.wav",
        "Resources/pulse.wav": "../../desktop-ui/public/sounds/reminders/pulse.wav",
        "Resources/marimba.wav": "../../desktop-ui/public/sounds/reminders/marimba.wav"
      }
    },
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/server": "server",
      "resources/cli": "cli",
      "resources/pg": "pg",
      "resources/rg": "rg"
    }
  }
}
