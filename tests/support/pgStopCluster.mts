/** Authenticated teardown of one explicitly recorded disposable Jest cluster. */
import { rm } from 'node:fs/promises';
import { ensurePostgresBinaries, PostgresRuntime } from '@snaglet/db/runtime/postgres';
import { loadTestClusterHandoff } from './pgTestCluster';

const handoffPath = process.argv[2];
if (!handoffPath) throw new Error('PostgreSQL teardown requires an explicit handoff file');
const handoff = loadTestClusterHandoff(handoffPath);

// Validation above must precede all runtime activity. Neither inherited DB
// overrides nor a user's default Snaglet home may select this teardown's target.
Object.assign(process.env, {
  SNAGLET_HOME: handoff.runtimeHome,
  SNAGLET_HOME_POINTER_FILE: `${handoff.runRoot}/unused-home-pointer.json`,
  SNAGLET_PG_DATA_DIR: handoff.dataDir,
  SNAGLET_PG_BINDIR: handoff.binaries.binDir,
  SNAGLET_PG_OWNED: '1',
  SNAGLET_DATABASE_URL: '',
  DATABASE_URL: '',
  SNAGLET_DB_MODE: 'managed',
});
const binaries = await ensurePostgresBinaries({ buildIfMissing: false });
const runtime = new PostgresRuntime({
  snagletHome: handoff.runtimeHome,
  dataDir: handoff.dataDir,
  env: process.env,
  ensureBinaries: async () => binaries,
});
const status = await runtime.status();
if (
  status.state === 'conflict' ||
  (status.pid !== undefined && status.pid !== handoff.postmasterPid)
) {
  throw new Error(`PostgreSQL test ownership changed; preserving ${handoff.runRoot}`);
}
await runtime.stop('fast');
const stopped = await runtime.status();
if (stopped.state !== 'stopped') {
  throw new Error(`PostgreSQL test shutdown unconfirmed; preserving ${handoff.runRoot}`);
}
// Both paths are generated by this run. Derive the socket directory from the
// validated data directory rather than trusting a handoff deletion target.
await rm(runtime.socketDir, { recursive: true, force: true });
await rm(handoff.runRoot, { recursive: true, force: true });
