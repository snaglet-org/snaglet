  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sidebar-tree": "./src/components/SidebarTree/index.ts",
