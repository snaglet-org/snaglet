{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "../../dist/snaglet-sdk",
    "rootDir": "."
  },
  "include": ["**/*"],
  "exclude": ["node_modules"],
  "extends": "../../tsconfig.base.json"
}
